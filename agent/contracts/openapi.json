{
  "openapi": "3.1.0",
  "info": {
    "title": "Care Bed Agent API",
    "version": "0.1.0",
    "description": "手机 APP 与护理床 Agent 的公开边界。APP 不提供远程床体控制接口。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "检查 Agent 服务状态",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "检查 Agent 服务状态",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Health"}
              }
            }
          }
        }
      }
    },
    "/api/v1/speech/status": {
      "get": {
        "summary": "检查本机中文语音识别状态",
        "description": "仅供本机床侧演示页使用，同时返回启动一次识别所需的会话令牌。",
        "responses": {
          "200": {
            "description": "本机识别器状态",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SpeechStatus"}
              }
            }
          },
          "403": {"description": "请求来源不是受信任的本机演示页"}
        }
      }
    },
    "/api/v1/speech/recognize": {
      "post": {
        "summary": "进行一次本机中文语音识别",
        "description": "使用 Windows System.Speech 和默认输入设备进行最长 8 秒的本地听写，音频不会上传。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SpeechRecognitionRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "识别成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SpeechRecognitionResult"}
              }
            }
          },
          "403": {"description": "令牌无效或请求来源不受信任"},
          "408": {"description": "在时间窗口内没有识别到语音"},
          "503": {"description": "本机识别器或麦克风不可用"}
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "summary": "查询共享床体状态",
        "responses": {
          "200": {
            "description": "当前权威状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "查询演示能力目录",
        "description": "返回 APP 可用于导航和能力展示的四个功能域。",
        "responses": {
          "200": {
            "description": "能力目录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agenda/today": {
      "get": {
        "summary": "查询用户今日事项",
        "description": "聚合当天提醒、护理待办和纪念日，不进入 Agent。",
        "parameters": [
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "elder-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "今日事项聚合",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodayAgenda"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo/overview": {
      "get": {
        "summary": "查询演示业务总览",
        "description": "供演示 UI 一次读取照护、关系和日常生活的内存状态。",
        "responses": {
          "200": {
            "description": "演示状态总览",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoOverview"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reminders": {
      "get": {
        "summary": "查询护理提醒",
        "responses": {
          "200": {
            "description": "提醒列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReminderList"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "创建结构化护理提醒",
        "description": "该请求走规则路径，不调用 Agent。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReminderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "提醒已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "400": {
            "description": "参数错误"
          }
        }
      }
    },
    "/api/v1/reminders/{reminder_id}": {
      "parameters": [
        {"name": "reminder_id", "in": "path", "required": true, "schema": {"type": "string"}}
      ],
      "patch": {
        "summary": "更新护理事项",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateReminderRequest"}}}
        },
        "responses": {"200": {"description": "更新后的护理事项"}, "400": {"description": "参数错误"}, "404": {"description": "护理事项不存在"}}
      },
      "delete": {
        "summary": "删除护理事项",
        "responses": {"200": {"description": "护理事项已删除"}, "404": {"description": "护理事项不存在"}}
      }
    },
    "/api/v1/voice-messages": {
      "post": {
        "summary": "发送结构化语音留言记录",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateVoiceMessageRequest"}}}
        },
        "responses": {"201": {"description": "留言已记录"}, "400": {"description": "参数错误"}}
      }
    },
    "/api/v1/calls": {
      "post": {
        "summary": "开始模拟通话",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartCallRequest"}}}
        },
        "responses": {"201": {"description": "通话已开始"}, "400": {"description": "参数错误"}}
      }
    },
    "/api/v1/calls/{call_id}": {
      "parameters": [
        {"name": "call_id", "in": "path", "required": true, "schema": {"type": "string"}}
      ],
      "patch": {
        "summary": "结束模拟通话",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EndCallRequest"}}}
        },
        "responses": {"200": {"description": "通话已结束"}, "400": {"description": "参数错误"}, "404": {"description": "通话不存在"}}
      }
    },
    "/api/v1/agent/messages": {
      "post": {
        "summary": "发送自然语言请求",
        "description": "仅用于需要理解或编排的任务；手机端床控请求会被拒绝。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent 已处理或请求补充信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "403": {
            "description": "不允许通过 APP 远程控制床体"
          },
          "501": {
            "description": "已理解，但对应技能尚未接入"
          }
        }
      }
    },
    "/api/v1/bedside/messages": {
      "post": {
        "summary": "发送床侧自然语言请求",
        "description": "请求固定标记为床侧语音来源，并经过确认、安全策略和确定性床控。可附带最多 16 条页面内短期上下文；历史只用于理解当前 text，不会被重新执行。",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BedsideMessageRequest"}}}
        },
        "responses": {
          "200": {"description": "Agent 已处理、请求确认或请求补充信息"},
          "400": {"description": "参数错误"},
          "501": {"description": "模型或技能不可用"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": {"type": "string", "const": "ok"},
          "service": {"type": "string", "const": "care-bed-agent"}
        }
      },
      "SpeechStatus": {
        "type": "object",
        "required": ["available", "engine", "language", "message", "request_token"],
        "properties": {
          "available": {"type": "boolean"},
          "engine": {"type": "string", "const": "windows-system-speech"},
          "language": {"type": "string", "const": "zh-CN"},
          "message": {"type": "string"},
          "request_token": {"type": "string", "minLength": 1}
        }
      },
      "SpeechRecognitionRequest": {
        "type": "object",
        "required": ["request_token"],
        "properties": {
          "request_token": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "SpeechRecognitionResult": {
        "type": "object",
        "required": ["text", "confidence", "engine", "language"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "engine": {"type": "string", "const": "windows-system-speech"},
          "language": {"type": "string", "const": "zh-CN"}
        }
      },
      "BedState": {
        "type": "object",
        "required": ["backrest_degrees", "legrest_degrees", "height_cm", "moving"],
        "properties": {
          "backrest_degrees": {"type": "integer", "minimum": 0, "maximum": 75},
          "legrest_degrees": {"type": "integer", "minimum": 0, "maximum": 40},
          "height_cm": {"type": "integer", "minimum": 40, "maximum": 75},
          "moving": {"type": "boolean"},
          "last_action": {"type": ["string", "null"]},
          "fault": {"type": ["string", "null"]}
        }
      },
      "SystemState": {
        "type": "object",
        "required": ["bed", "revision"],
        "properties": {
          "bed": {"$ref": "#/components/schemas/BedState"},
          "revision": {"type": "integer", "minimum": 0}
        }
      },
      "CapabilityDomain": {
        "type": "object",
        "required": ["id", "name", "features"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "features": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      },
      "CapabilityCatalog": {
        "type": "object",
        "required": ["domains"],
        "properties": {
          "domains": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/CapabilityDomain"}
          }
        }
      },
      "Reminder": {
        "type": "object",
        "required": ["reminder_id", "recipient", "scheduled_for", "message", "created_by", "note", "status", "enabled"],
        "properties": {
          "reminder_id": {"type": "string", "format": "uuid"},
          "recipient": {"type": "string"},
          "scheduled_for": {"type": "string"},
          "message": {"type": "string"},
          "created_by": {"type": ["string", "null"]},
          "note": {"type": "string"},
          "status": {"type": "string", "enum": ["done", "upcoming", "attention"]},
          "enabled": {"type": "boolean"}
        }
      },
      "ReminderList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Reminder"}
          }
        }
      },
      "CareTodo": {
        "type": "object",
        "required": ["todo_id", "title", "due", "status", "created_by", "created_at"],
        "properties": {
          "todo_id": {"type": "string", "format": "uuid"},
          "title": {"type": "string"},
          "due": {"type": "string"},
          "status": {"type": "string"},
          "created_by": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Anniversary": {
        "type": "object",
        "required": ["anniversary_id", "person", "kind", "month_day"],
        "properties": {
          "anniversary_id": {"type": "string", "format": "uuid"},
          "person": {"type": "string"},
          "kind": {"type": "string"},
          "month_day": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"}
        }
      },
      "TodayAgenda": {
        "type": "object",
        "required": ["date", "reminders", "todos", "anniversaries"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "reminders": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Reminder"}
          },
          "todos": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/CareTodo"}
          },
          "anniversaries": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Anniversary"}
          }
        }
      },
      "CareRecord": {
        "type": "object",
        "required": ["record_id", "content", "created_by", "recorded_at"],
        "properties": {
          "record_id": {"type": "string", "format": "uuid"},
          "content": {"type": "string"},
          "created_by": {"type": "string"},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      },
      "CallSession": {
        "type": "object",
        "required": ["call_id", "contact", "priority", "status", "initiated_by", "started_at", "ended_at"],
        "properties": {
          "call_id": {"type": "string", "format": "uuid"},
          "contact": {"type": "string"},
          "priority": {"type": "string", "enum": ["normal", "emergency"]},
          "status": {"type": "string"},
          "initiated_by": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": ["string", "null"], "format": "date-time"}
        }
      },
      "VoiceMessage": {
        "type": "object",
        "required": ["message_id", "sender", "recipient", "content", "status", "created_at", "duration_seconds", "summary"],
        "properties": {
          "message_id": {"type": "string", "format": "uuid"},
          "sender": {"type": "string"},
          "recipient": {"type": "string"},
          "content": {"type": "string"},
          "status": {"type": "string", "enum": ["unread", "played"]},
          "created_at": {"type": "string", "format": "date-time"},
          "duration_seconds": {"type": "integer", "minimum": 0},
          "summary": {"type": "string"}
        }
      },
      "PersonalNote": {
        "type": "object",
        "required": ["note_id", "content", "created_by", "created_at"],
        "properties": {
          "note_id": {"type": "string", "format": "uuid"},
          "content": {"type": "string"},
          "created_by": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Notification": {
        "type": "object",
        "required": ["notification_id", "recipient", "channel", "message"],
        "properties": {
          "notification_id": {"type": "string", "format": "uuid"},
          "recipient": {"type": "string"},
          "channel": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "Weather": {
        "type": "object",
        "required": ["city", "condition", "temperature_c", "high_c", "low_c", "source"],
        "properties": {
          "city": {"type": "string"},
          "condition": {"type": "string"},
          "temperature_c": {"type": "integer"},
          "high_c": {"type": "integer"},
          "low_c": {"type": "integer"},
          "source": {"type": "string"}
        }
      },
      "MediaState": {
        "type": "object",
        "required": ["status", "query"],
        "properties": {
          "status": {"type": "string", "enum": ["idle", "playing"]},
          "query": {"type": ["string", "null"]}
        }
      },
      "CareCoordinationOverview": {
        "type": "object",
        "required": ["reminders", "records", "todos", "notifications"],
        "properties": {
          "reminders": {"type": "array", "items": {"$ref": "#/components/schemas/Reminder"}},
          "records": {"type": "array", "items": {"$ref": "#/components/schemas/CareRecord"}},
          "todos": {"type": "array", "items": {"$ref": "#/components/schemas/CareTodo"}},
          "notifications": {"type": "array", "items": {"$ref": "#/components/schemas/Notification"}}
        }
      },
      "RelationshipOverview": {
        "type": "object",
        "required": ["calls", "voice_messages", "anniversaries"],
        "properties": {
          "calls": {"type": "array", "items": {"$ref": "#/components/schemas/CallSession"}},
          "voice_messages": {"type": "array", "items": {"$ref": "#/components/schemas/VoiceMessage"}},
          "anniversaries": {"type": "array", "items": {"$ref": "#/components/schemas/Anniversary"}}
        }
      },
      "DailyLifeOverview": {
        "type": "object",
        "required": ["notes", "weather", "media"],
        "properties": {
          "notes": {"type": "array", "items": {"$ref": "#/components/schemas/PersonalNote"}},
          "weather": {"$ref": "#/components/schemas/Weather"},
          "media": {"$ref": "#/components/schemas/MediaState"}
        }
      },
      "DemoOverview": {
        "type": "object",
        "required": ["care_coordination", "relationship", "daily_life"],
        "properties": {
          "care_coordination": {"$ref": "#/components/schemas/CareCoordinationOverview"},
          "relationship": {"$ref": "#/components/schemas/RelationshipOverview"},
          "daily_life": {"$ref": "#/components/schemas/DailyLifeOverview"}
        }
      },
      "CreateReminderRequest": {
        "type": "object",
        "required": ["recipient", "scheduled_for", "message"],
        "properties": {
          "actor_id": {"type": "string"},
          "recipient": {"type": "string"},
          "scheduled_for": {"type": "string", "format": "date-time"},
          "message": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["done", "upcoming", "attention"]},
          "enabled": {"type": "boolean"}
        }
      },
      "UpdateReminderRequest": {
        "type": "object",
        "properties": {
          "scheduled_for": {"type": "string"},
          "message": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["done", "upcoming", "attention"]},
          "enabled": {"type": "boolean"}
        }
      },
      "CreateVoiceMessageRequest": {
        "type": "object",
        "required": ["sender", "recipient", "content"],
        "properties": {
          "sender": {"type": "string"},
          "recipient": {"type": "string"},
          "content": {"type": "string", "minLength": 1},
          "duration_seconds": {"type": "integer", "minimum": 0},
          "summary": {"type": "string"}
        }
      },
      "StartCallRequest": {
        "type": "object",
        "required": ["contact"],
        "properties": {
          "contact": {"type": "string", "minLength": 1},
          "initiated_by": {"type": "string"}
        }
      },
      "EndCallRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {"status": {"type": "string", "const": "ended"}}
      },
      "AgentMessageRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "actor_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1}
        }
      },
      "ConversationMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      },
      "BedsideMessageRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "actor_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "history": {
            "type": "array",
            "maxItems": 16,
            "items": {"$ref": "#/components/schemas/ConversationMessage"}
          }
        }
      },
      "AgentResult": {
        "type": "object",
        "required": ["event_id", "path", "status", "code", "message", "data"],
        "properties": {
          "event_id": {"type": "string"},
          "path": {"type": "string", "enum": ["direct", "rule", "agent", "observe"]},
          "status": {
            "type": "string",
            "enum": ["completed", "rejected", "needs_clarification", "needs_confirmation", "failed"]
          },
          "code": {"type": "string"},
          "message": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    }
  }
}
