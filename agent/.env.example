# Copy this file to .env and fill in your local API key.
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_TEMPERATURE=1
GLM_TOP_P=0.95
GLM_REASONING_EFFORT=max
GLM_CLEAR_THINKING=false
GLM_STREAM=true
GLM_TOOL_STREAM=true
GLM_TIMEOUT_SECONDS=120

# Low-latency profile used by natural-language intent recognition.
GLM_INTENT_TEMPERATURE=0.2
GLM_INTENT_TOP_P=0.8
GLM_INTENT_REASONING_EFFORT=low
GLM_INTENT_CLEAR_THINKING=false
GLM_INTENT_TIMEOUT_SECONDS=15
